# ==============================================================================
# TradeDrift AWS EC2 Production Environment Configuration Template
# File: .env.production.template
#
# INSTRUCTIONS FOR DEPLOYMENT:
# 1. Copy this file to '.env.production' on your AWS EC2 instance:
#      cp .env.production.template .env.production
# 2. Generate cryptographically strong random secrets for all placeholder values:
#      openssl rand -hex 32
# 3. Fill in your Vercel frontend URL, Google OAuth Client ID, and database credentials.
# 4. NEVER commit your actual '.env.production' file to Git!
# ==============================================================================

# ─── Environment Mode ─────────────────────────────────────────────────────────
ENV=production
APP_ENV=production
LOG_LEVEL=info
AUTO_MIGRATE=false

# ─── Public Frontend & CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Must match your Vercel deployment domain and any custom apex/subdomains.
CORS_ALLOWED_ORIGINS=https://tradedrift-frontend.vercel.app

# ─── Security Secrets (Min 32 Characters / Hex) ──────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_SECURE_32_BYTE_HEX_JWT_SECRET
RECONCILIATION_ADMIN_SECRET=REPLACE_WITH_SECURE_32_BYTE_HEX_RECONCILIATION_SECRET
WEBHOOK_SECRET=REPLACE_WITH_SECURE_32_BYTE_HEX_WEBHOOK_SECRET

# ─── PostgreSQL Database Credentials ──────────────────────────────────────────
# Used by internal docker-compose.prod.yml postgres service or AWS RDS.
POSTGRES_USER=tradedrift_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD

# ─── Redis Cache & In-Memory Store ───────────────────────────────────────────
# Leave blank if running on private Docker network with no auth, or supply secret:
REDIS_PASSWORD=

# ─── Google OAuth 2.0 (Authentication Service) ───────────────────────────────
# Must match the Client ID created in Google Cloud Console
GOOGLE_CLIENT_ID=778142269213-7e4knagb3r5cfhq2kdrj6nr8qlueobr4.apps.googleusercontent.com

# ─── Payment Gateway & Top-Up Service ────────────────────────────────────────
# TradeDrift is an exchange simulator. Keep PAYMENT_PROVIDER=MOCK for safe demo mode.
# If live Razorpay payments are approved, set PAYMENT_PROVIDER=RAZORPAY and supply keys.
PAYMENT_PROVIDER=MOCK
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DAILY_LIMIT_INR=10

# ─── API Gateway Traffic Controls ────────────────────────────────────────────
GATEWAY_RATE_LIMIT_RPS=50
GATEWAY_RATE_LIMIT_BURST=100

# ─── Observability (Grafana) ─────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_SECURE_GRAFANA_ADMIN_PASSWORD

