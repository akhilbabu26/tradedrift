# Settlement Service — Environment Variables
# Copy this file to .env and fill in your local values.
# NEVER commit .env to Git — it is excluded by .gitignore.

# PostgreSQL connection string for the tradedrift_settlement database
SETTLEMENT_POSTGRES_DSN=

# Path to goose migration files (relative to the binary working directory)
SETTLEMENT_MIGRATIONS_DIR=migration

# Comma-separated Kafka broker addresses
KAFKA_BROKERS=

# Kafka consumer group ID for the Settlement Service
KAFKA_GROUP_ID=settlement-service-group

# Kafka topic to consume TradeExecuted events from
KAFKA_TOPIC_TRADE_EXECUTED=trades.executed

# Wallet Service gRPC address (host:port)
WALLET_GRPC_ADDR=

# Per-RPC timeout for Wallet.SettleTrade calls
# Prevents a hung Wallet Service from stalling the Kafka consumer
# Format: Go duration string (e.g. 2s, 5s, 10s)
WALLET_GRPC_TIMEOUT=5s

# Log level: debug | info | warn | error
LOG_LEVEL=info
