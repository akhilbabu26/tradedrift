# ==============================================================================
# TradeDrift Platform Environment Configuration Reference (.env.example)
#
# INSTRUCTIONS:
# 1. Do NOT commit production values or real credentials to source control.
# 2. In local Docker Compose, standard defaults point to container DNS names.
# 3. In AWS deployment, inject values via AWS Secrets Manager or Systems Manager
#    Parameter Store into container definitions (ECS / EKS).
# 4. In production (ENV=production), services strictly fail fast if critical
#    secrets match insecure dev fallbacks or if localhost addresses are used.
# ==============================================================================

# ------------------------------------------------------------------------------
# Global Platform Settings
# ------------------------------------------------------------------------------
ENV=development                          # "development" | "production"
APP_ENV=development                      # Alias for ENV
AUTO_MIGRATE=true                        # In prod, set to "false" and use dedicated migration runner
LOG_LEVEL=info                           # "debug" | "info" | "warn" | "error"

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret for HMAC-SHA256 token verification
JWT_SECRET=replace-with-a-secure-random-32-byte-hex-string-for-production
TOKEN_EXPIRY=24h
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# Shared Infrastructure Services
# ------------------------------------------------------------------------------
KAFKA_BROKERS=kafka:9092
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 1. API Gateway Service (Public Facing)
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
GATEWAY_AUTH_SERVICE_ADDR=auth:50051
GATEWAY_WALLET_SERVICE_ADDR=wallet:50052
GATEWAY_ORDER_SERVICE_ADDR=order:50053
GATEWAY_MARKET_SERVICE_ADDR=market:50054
GATEWAY_MATCHING_ENGINE_ADDR=matching-engine:50055
GATEWAY_SETTLEMENT_SERVICE_ADDR=settlement:50056
GATEWAY_PORTFOLIO_SERVICE_ADDR=portfolio:50057
GATEWAY_TRADE_SERVICE_ADDR=trade:50058
GATEWAY_WALLET_TOPUP_SERVICE_ADDR=wallet-topup:8084

# ------------------------------------------------------------------------------
# 2. Authentication Service
# ------------------------------------------------------------------------------
AUTH_PORT=50051
AUTH_POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/tradedrift_auth?sslmode=disable
AUTH_REDIS_ADDR=redis:6379

# ------------------------------------------------------------------------------
# 3. Wallet Service
# ------------------------------------------------------------------------------
WALLET_PORT=50052
WALLET_POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/tradedrift_wallet?sslmode=disable

# ------------------------------------------------------------------------------
# 4. Order Service
# ------------------------------------------------------------------------------
ORDER_PORT=50053
ORDER_POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/tradedrift_order?sslmode=disable
ORDER_WALLET_SERVICE_ADDR=wallet:50052
ORDER_REDIS_ADDR=redis:6379

# ------------------------------------------------------------------------------
# 5. Market Service
# ------------------------------------------------------------------------------
MARKET_PORT=50054
MARKET_POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/tradedrift_market?sslmode=disable
MARKET_REDIS_ADDR=redis:6379

# ------------------------------------------------------------------------------
# 6. Matching Engine
# ------------------------------------------------------------------------------
MATCHING_ENGINE_HTTP_PORT=8085
MATCHING_ENGINE_GRPC_PORT=50055
MATCHING_ENGINE_POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/tradedrift_matching_engine?sslmode=disable
MATCHING_ENGINE_REDIS_ADDR=redis:6379

# ------------------------------------------------------------------------------
# 7. Settlement Service
# ------------------------------------------------------------------------------
SETTLEMENT_PORT=50056
SETTLEMENT_POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/tradedrift_settlement?sslmode=disable
SETTLEMENT_WALLET_SERVICE_ADDR=wallet:50052

# ------------------------------------------------------------------------------
# 8. Portfolio Service
# ------------------------------------------------------------------------------
PORTFOLIO_PORT=50057
PORTFOLIO_POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/tradedrift_portfolio?sslmode=disable

# ------------------------------------------------------------------------------
# 9. Trade Service
# ------------------------------------------------------------------------------
TRADE_PORT=50058
TRADE_POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/tradedrift_trade?sslmode=disable

# ------------------------------------------------------------------------------
# 10. Notification Service
# ------------------------------------------------------------------------------
NOTIFICATION_PORT=50059
NOTIFICATION_POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/tradedrift_notification?sslmode=disable

# ------------------------------------------------------------------------------
# 11. Admin Service
# ------------------------------------------------------------------------------
ADMIN_PORT=8082
ADMIN_POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/tradedrift_admin?sslmode=disable
ADMIN_MATCHING_ENGINE_ADDR=matching-engine:50055

# ------------------------------------------------------------------------------
# 12. Wallet Top-Up Service
# ------------------------------------------------------------------------------
WALLET_TOPUP_PORT=8084
WALLET_TOPUP_POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/tradedrift_topup?sslmode=disable
WALLET_TOPUP_WALLET_GRPC_ADDR=wallet:50052
PAYMENT_PROVIDER=MOCK                    # In production: must be "RAZORPAY"
RAZORPAY_KEY_ID=rzp_test_placeholder     # Required if PAYMENT_PROVIDER=RAZORPAY
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
WEBHOOK_SECRET=topup_mock_secret_key_12345
DAILY_LIMIT_INR=10

# ------------------------------------------------------------------------------
# 13. Liquidity Engine
# ------------------------------------------------------------------------------
LE_ORDER_SERVICE_ADDR=order:50053
LE_WALLET_SERVICE_ADDR=wallet:50052
LE_MARKET_SERVICE_ADDR=market:50054

# ------------------------------------------------------------------------------
# 14. Controlled Taker
# ------------------------------------------------------------------------------
CT_ORDER_SERVICE_ADDR=order:50053
CT_MARKET_SERVICE_ADDR=market:50054
CT_PORTFOLIO_SERVICE_ADDR=portfolio:50057

